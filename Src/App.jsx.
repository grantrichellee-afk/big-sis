const waMessage = encodeURIComponent(
`Hello, I would like to join the Big Sis community.\n\n` +
`--- My Information ---\n` +
`Name: ${name || "___"}\n` +
`Age: ${age || "___"}\n` +
`What I am struggling with: ${struggle || "___"}\n\n` +
`--- Community Standards Agreement ---\n` +
`I have read and I fully agree to the following:\n\n` +
RULES.map((r, i) => `${i + 1}. ${r}`).join(”\n”) +
`\n\nPlease add me to the group. I am ready to connect with a sister who understands.`
);

const waLink = `https://wa.me/${WHATSAPP_NUMBER}?text=${waMessage}`;

